# ---------------------------------------------------------------------------
# TaskMaster API configuration. Copy to `.env` and adjust.
# Every variable is validated at boot (src/config/env.js).
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# MongoDB connection string (docker compose exposes one on localhost:27017)
MONGODB_URI=mongodb://localhost:27017/taskmaster

# Auth - generate a secret with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_ISSUER=taskmaster-api
JWT_AUDIENCE=taskmaster-clients
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_SALT_ROUNDS=12

# HTTP
# Comma separated browser origins allowed by CORS / Socket.IO, or *
CORS_ORIGINS=*
# Number of reverse proxies in front of the app (needed for correct client IPs)
TRUST_PROXY=0
# Defaults to true in production
# COOKIE_SECURE=true

# Rate limiting (per window)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
AI_RATE_LIMIT_MAX=30

# Attachments
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10
MAX_FILES_PER_UPLOAD=5

# Retention
INVITATION_TTL_DAYS=7
NOTIFICATION_TTL_DAYS=90

# Generative AI (optional). Without a key the /ai endpoints return 503.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
